{
  "name": "@faberon/chat",
  "version": "0.1.0",
  "description": "Faberon Chat: a Pi extension for drafting plans and operating campaigns",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevren-ai/faberon.git",
    "directory": "packages/chat"
  },
  "homepage": "https://github.com/sevren-ai/faberon",
  "bugs": "https://github.com/sevren-ai/faberon/issues",
  "type": "module",
  "bin": {
    "faberon-chat": "bin/faberon-chat.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^22.19.0",
    "prettier": "^3.5.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
